# ==========================================
# 1. Custom Application Secrets & Credentials
# ==========================================
# Ignore your dedicated configuration files containing email/DB keys
.env
.env.local

# ==========================================
# 2. Uploads & Public Assets (Optional but Recommended)
# ==========================================
# Prevent testing uploads (like generated QR codes or tickets) from cluttering the repo
modules/Registrants/uploads/
uploads/qrcodes/
*.png
*.jpg
*.pdf

# ==========================================
# 3. Development Tools & IDE Cache Files
# ==========================================
# Ignore VS Code, PHPStorm, or text editor local cache settings
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln

# ==========================================
# 4. OS & Environment Metadata
# ==========================================
# Ignore system junk files generated by Windows or Mac
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store